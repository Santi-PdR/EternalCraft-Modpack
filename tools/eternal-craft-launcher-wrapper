#!/usr/bin/env bash
set -euo pipefail

BASE="${HOME}/.local/opt/eternal-craft-launcher-developer"
APPIMAGE="$BASE/Eternal-Craft-Launcher-Developer.AppImage"

# Fedora installations without /dev/fuse use the extracted Developer AppDir.
# The build entrypoint, not a caller-controlled flag, selects this private variant.
if [[ -x "$BASE/app/EternalCraftLauncherDeveloper" ]]; then
  exec "$BASE/app/EternalCraftLauncherDeveloper" "$@"
fi

if [[ -x "$APPIMAGE" ]]; then
  if [[ -r /dev/fuse && -w /dev/fuse ]]; then
    exec "$APPIMAGE" "$@"
  fi
  exec "$APPIMAGE" --appimage-extract-and-run "$@"
fi

echo "No se encontró la build privada Developer en $APPIMAGE ni en $BASE/app." >&2
exit 1
